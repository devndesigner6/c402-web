# C402 Backend Configuration variables
PORT=8080

# Developer payout address (where ADA is received)
PAYOUT_ADDRESS=addr_test1qrf9x2y4u9asqpwldjge937cnu2c7d9bc029ac1bf58cd

# Cardano network used by this gateway
CARDANO_NETWORK=preprod

# Blockfrost Preprod Project API Key (required for payment verification)
BLOCKFROST_KEY=preprodYourBlockfrostApiKeyHere

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,https://your-project.vercel.app

# Cerebras API key for live protected AI responses
CEREBRAS_KEY=your_cerebras_api_key_here

# Admin token for protected cache management endpoints
ADMIN_TOKEN=your_secure_random_token_here
